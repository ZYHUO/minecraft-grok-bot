MC_HOST=127.0.0.1
MC_PORT=25565
MC_VERSION=1.20.1

# Per-bot OAuth client (do not commit real secrets)
GROK_CLIENT_ID=andy
GROK_CLIENT_SECRET=
GROK_TOKEN_URL=http://127.0.0.1:3200/oauth/token
GROK_MC_AUDIENCE=mc-paper-1.20.1

# Optional transition: static token if TOKEN_URL is down (plugin allow-legacy-token)
# GROK_BOT_TOKEN=

# Cloudflare Tunnel (this Paper box). Local bots ignore this.
# CLOUDFLARED_TOKEN=

# Remote Grok bot joining a Modflared / CF-tunnelled server (other machine):
# MC_HOST=play.example.net
# MC_TUNNEL=auto
# MC_TUNNEL_HOST=
# MC_TUNNEL_BACKEND=embedded
# TUNNEL_SERVICE_TOKEN_ID=
# TUNNEL_SERVICE_TOKEN_SECRET=
